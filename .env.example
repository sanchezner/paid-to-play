# Postgres connection string
CONN_STRING=postgresql://user:password@host/dbname?sslmode=require

# S3 bucket where bronze-layer JSON is stored
S3_BUCKET=your-bucket-name

# MLflow tracking URI (local dev)
TRACKING_URI=sqlite:///mlflow.db

# AWS credentials for S3 access (boto3 reads these automatically)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-2

# Prefect Cloud (only needed when running scheduled flows via Prefect)
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=your-api-key
